{
    "name": "eduardlleshi/laravel-cross-database-subqueries",
    "description": "Eloquent cross database compatibility in subqueries",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/container": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/events": "^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.3 || ^12 || ^13",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hoyvoy\\CrossDatabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hoyvoy\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hoyvoy\\CrossDatabase\\CrossDatabaseServiceProvider"
            ]
        }
    }
}
